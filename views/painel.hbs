<style>
    .painel-page .painel-coluna {
        min-height: 14rem;
    }
    .painel-page .painel-cabecalho {
        min-height: 4.5rem;
    }
    .painel-page .pedido-numero {
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 1.1;
    }
    @media (max-width: 767.98px) {
        .painel-page .painel-coluna {
            min-height: 10rem;
        }
        .painel-page .painel-cabecalho {
            min-height: 3.5rem;
            font-size: 1.5rem !important;
        }
    }
</style>
<div class="modal top fade" id="pedidoModal">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-warning">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Pedido Pronto</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="modalMessage">
            </div>
        </div>
    </div>
</div>
<div class="painel-page">
<div class="row g-1">
    <div class="col-6">
        <div class="fs-1 text-start bg-secondary text-white px-2 py-2 painel-cabecalho">🐙 Preparando <span id="preparandoCount" class="badge bg-light text-dark">0</span></div>
    </div>
    <div class="col-6">
        <div class="fs-1 text-start bg-danger text-white px-2 py-2 painel-cabecalho">😋 Pronto <span id="prontoCount" class="badge bg-light text-dark">0</span></div>
    </div>
</div>
<div class="row" id="pedidos">
</div>
</div>
<script>
    const socket = io();
    socket.on('connect', () => updateConnectionIndicator('online'));
    socket.on('disconnect', () => updateConnectionIndicator('offline'));
    socket.on('connect_error', () => updateConnectionIndicator('offline'));
    socket.on('connection', e => load());
    socket.on('all', e => load());
    socket.on('pronto', data => {
        let numero = parseNumero(data);
        const imagens = ['/takoyakisan/1.png', '/takoyakisan/2.png', '/takoyakisan/3.png'];
        const imagem = imagens[Math.floor(Math.random() * imagens.length)];
        $(`#modalMessage`).children().remove();
        $('#modalMessage').append(`
        <div class="text-center" style="font-size:15vw;">${numero}</div>
        <img src="${imagem}" class="rounded mx-auto d-block" alt="Pedido pronto">
        `);
        $('#pedidoModal').modal('show');
        setTimeout(() => { $('#pedidoModal').modal('hide'); }, 5000);
    });
    async function load() {
        const pedidos = await fetchPedidos();
        $(`#pedidos`).children().remove();
        $('#preparandoCount').text(pedidos.preparando.length);
        $('#prontoCount').text(pedidos.pronto.length);
        loadPedidos(pedidos.preparando, 'preparando');
        loadPedidos(pedidos.pronto, 'pronto');
    }

    function loadPedidos(pedido, tipo) {
        const numRow = {{rowsNumber}};
        if (pedido.length == 0) {
            $("#pedidos").append(`<div class="col-6 painel-coluna d-flex align-items-center justify-content-center text-muted fs-4">Nenhum pedido</div>`);
        } else {
            const smPedido = Math.max(Math.floor(6 / Math.ceil(pedido.length / numRow)), 2);
            const colNumber = Math.min(Math.ceil(pedido.length / numRow), {{colNumber}});
            for (let i = 0; i < colNumber; i++) {
                let size = i + 1 == colNumber ? pedido.length : (i + 1) * numRow;
                let str = "";
                for (let j = i * numRow; j < size; j++) {
                    let numero = parseNumero(pedido[j]);
                    str += `<div class="pedido-numero text-start border-bottom py-2">${numero}</div>`
                }
                $("#pedidos").append(`<div class="col-6 col-md-${smPedido} painel-coluna px-3">${str}</div>`);
            }
        }

    }
</script>
