<style>
    @media (max-width: 575.98px) {
        .caixa-page {
            padding-bottom: 5.5rem;
        }

        .caixa-page .card-body {
            padding-left: .5rem;
            padding-right: .5rem;
        }

        .caixa-page #descricaoInput {
            height: 76px !important;
        }

        .caixa-page #enviarButton {
            position: fixed;
            z-index: 1030;
            left: .75rem;
            right: .75rem;
            bottom: .75rem;
            width: calc(100% - 1.5rem);
            box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .2);
            min-height: 4rem;
        }

        .caixa-page .btn-outline-success {
            min-height: 4.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .caixa-page #pedido button {
            min-height: 3.5rem;
        }

        .caixa-page #pedido .pedido-tipo {
            font-size: 1.5rem !important;
        }

        .caixa-page #pedido .pedido-detalhes {
            font-size: 1rem;
        }
    }
</style>
<div class="container-fluid py-3 caixa-page">
    <div class="p-3 card text-center">
        <div class="card-header">
            <h1 class="card-title display-4 mb-1">CAIXA 🛒</h1>
            <p class="text-muted mb-0">Registre o pedido para a cozinha</p>
        </div>
        <div class="card-body">
            <form class="needs-validation" novalidate>
                <div class="row align-items-center">
                    <div class="col-md-6 mb-3">
                        <label class="form-label visually-hidden" for="numeroInput">Número do pedido</label>
                        <input type="number" min="0" step="1" class="form-control form-control-lg" placeholder="Número do pedido"
                            id="numeroInput" autocomplete="off" value="{{numeroPedido}}" required>
                        <div class="invalid-feedback">Informe um número de pedido válido.</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label visually-hidden" for="quantidadeInput">Quantidade</label>
                        <input type="number" min="1" step="1" class="form-control form-control-lg" placeholder="Quantidade"
                            id="quantidadeInput" autocomplete="off" value="1" required>
                        <div class="invalid-feedback">Informe uma quantidade maior que zero.</div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="form-floating">
                            <textarea class="form-control" style="height: 100px" id="descricaoInput"
                                autocomplete="off"></textarea>
                            <label for="descricaoInput">Descrição do Pedido (opcional)</label>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="d-grid gap-2 col-12 col-md-6 mx-auto mb-2 mb-md-0">
                        <input class="btn-check form-check-input" type="radio" name="flexRadioDefault"
                            id="flexRadioDefault1" value="true">
                        <label class="btn btn-success py-3" for="flexRadioDefault1">
                            <span class="fs-2">🚗 Viagem</span>
                        </label>
                    </div>
                    <div class="d-grid gap-2 col-12 col-md-6 mx-auto">
                        <input class="btn-check form-check-input" type="radio" name="flexRadioDefault"
                            id="flexRadioDefault2" value="false" checked>
                        <label class="btn btn-success py-3" for="flexRadioDefault2">
                            <span class="fs-2">🥢 Comer Aqui</span>
                        </label>
                    </div>
                </div>
                <div class="mt-auto p-2 row align-items-center">
                    <button class="btn btn-lg btn-block btn-primary" type="submit" id="enviarButton">
                        <span class="fs-2">Enviar pedido</span>
                    </button>
                </div>
                <div id="formMessage" class="alert d-none mb-0" role="status" aria-live="polite"></div>
            </form>
        </div>
        <div class="card-footer text-muted">
            <div class="mb-3">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="fs-2 text-center bg-secondary text-white py-2">
                            🐙 Preparando <span id="preparandoCount" class="badge bg-light text-dark">0</span>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="row row-gap-3" id="pedido">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    const socket = io();
    socket.on('connect', () => updateConnectionIndicator('online'));
    socket.on('disconnect', () => updateConnectionIndicator('offline'));
    socket.on('connect_error', () => updateConnectionIndicator('offline'));
    socket.on('connection', data => load());
    socket.on('all', data => load());
    (function () {
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault()
                    event.stopPropagation()
                    if (form.checkValidity() && Number($('#quantidadeInput').val()) > 0) {
                        let numero = parseInt($('#numeroInput').val());
                        let viagem = document.querySelector('input[name="flexRadioDefault"]:checked').value === 'true';
                        let descricao = $('#descricaoInput').val().trim();
                        let quantidade = parseInt($('#quantidadeInput').val());
                        sendPedido({ numero, viagem, descricao, quantidade });
                    } else {
                        form.classList.add('was-validated');
                    }
                }, false)
            })
    })()
    async function update(action, pedido) {
        $.ajax({
            url: `/pedido/${action}`,
            processData: false,
            type: 'PUT',
            data: JSON.stringify({ numero: pedido }),
            processData: false,
            contentType: 'application/json',
        }).done(function () {
            showFormMessage(`Pedido ${pedido} cancelado.`, 'success');
            load();
        }).fail(function () {
            showFormMessage('Não foi possível atualizar o pedido.', 'danger');
        });
    }
    async function load() {
        const pedidos = await fetchPedidos();
        loadPedidos(pedidos.preparando);
    }

    function loadPedidos(pedido, tipo) {
        $('#preparandoCount').text(pedido.length);
        $(`#pedido`).children().remove();
        if (pedido.length == 0) {
            $(`#pedido`).append(`<div class="col-12 py-3 text-center text-muted">Nenhum pedido aguardando preparo.</div>`);
        } else {
            for (let i = 0; i < pedido.length; i++) {
                let str = "";
                const viagem = parseTipoPedido(pedido[i]);
                str += `<div class="col-12 border-bottom py-2">
                            <div class="row align-items-center g-2">
                                <div class="col-4 col-md-2 fs-2 text-center pedido-tipo" title="${viagem.label}">${viagem.icon}<small class="d-block fs-6">${viagem.label}</small></div>
                                <div class="col-8 col-md-6 text-start pedido-detalhes"><strong>Pedido ${parseNumero(pedido[i])}</strong><br><span class="text-muted">${escapeHtml(pedido[i].descricao) || 'Sem descrição'}</span><span class="badge bg-secondary ms-2">Qtd. ${pedido[i].quantidade}</span></div>
                                <button type="button" onclick="cancelarPedido(${pedido[i].numero})" class="col-12 col-md-2 btn btn-outline-warning">Cancelar</button>
                            </div>
                        </div>`
                $(`#pedido`).append(` ${str}`);
            }
        }
    }

    function cancelarPedido(numero) {
        if (confirm(`Cancelar o pedido ${numero}?`)) update('cancelar', numero);
    }

    function escapeHtml(value) {
        return $('<div>').text(value || '').html();
    }

    function parseTipoPedido(pedido) {
        return pedido.viagem
            ? { icon: "🚗", label: "Viagem" }
            : { icon: "🥢", label: "Comer aqui" };
    }
</script>
