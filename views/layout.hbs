<!DOCTYPE html>
<html>

<head>
    <title>{{title}}</title>
    <link rel="icon" type="image/png" href="/takoyakisan/1.png">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/socket/socket.io.min.js"></script>
    <script src="/jquery-3.7.0.min.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        #connectionIndicator {
            position: fixed;
            top: .5rem;
            right: .5rem;
            z-index: 1100;
            font-size: .8rem;
        }
        #connectionIndicator .connection-dot {
            display: inline-block;
            width: .55rem;
            height: .55rem;
            border-radius: 50%;
            background: currentColor;
        }
    </style>

</head>
<script>
    async function fetchPedidos() {
        return new Promise((resolve) => {
            $.ajax({
                url: `/pedidos`,
                type: 'GET',
                contentType: 'application/json',
                success: function (data) {
                    resolve(data);
                },
            })
        })
    }
    function showFormMessage(message, type) {
        const element = $('#formMessage');
        element.removeClass('d-none alert-success alert-danger').addClass(`alert-${type}`).text(message);
    }
    function sendPedido(pedido) {
        new Promise((resolve) => {
            $.ajax({
                url: '/pedido',
                data: JSON.stringify(pedido),
                type: 'POST',
                contentType: 'application/json',
                error: function (error) {
                    let message = error?.responseJSON?.message || 'Não foi possível enviar o pedido.';
                    $(`#numeroInput`).addClass('is-invalid');
                    showFormMessage(message, 'danger');
                }, success: function (data) {
                    resolve(data)
                    showFormMessage(`Pedido ${pedido.numero} enviado para a cozinha.`, 'success');
                    $('#descricaoInput').val('');
                    $('#quantidadeInput').val('1');
                    $('#numeroInput').val(Number(pedido.numero) + 1).removeClass('is-invalid').trigger('focus');
                    $('.needs-validation').removeClass('was-validated');
                    if (typeof load === 'function') load();
                }
            })
        })
    }
    function parseViagem(pedido) {
        return pedido.viagem ? "🚗" : "🥢";
    }
    function parseNumero(pedido) {
        return pedido.numero;
    }
    function updateConnectionIndicator(status) {
        const labels = { connecting: 'Conectando', online: 'Online', offline: 'Offline' };
        const classes = { connecting: 'bg-secondary', online: 'bg-success', offline: 'bg-danger' };
        $('#connectionIndicator').removeClass('bg-secondary bg-success bg-danger')
            .addClass(classes[status] || classes.connecting)
            .html(`<span class="connection-dot"></span> ${labels[status] || labels.connecting}`);
    }
</script>

<body>
    <div id="connectionIndicator" class="badge bg-secondary" role="status" aria-live="polite">
        <span class="connection-dot"></span> Conectando
    </div>
    {{{body}}}
</body>


</html>
